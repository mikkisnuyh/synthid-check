{
  "description": "Check images, video and audio for a SynthID watermark. Drag, right-click or pick media to check it in Google's detector.",
  "minimum_chrome_version": "148",
  "incognito": "split",
  "message_serialization": "structured_clone",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": null,
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": null,
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": null,
  "+content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/context-target.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
