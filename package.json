{
  "name": "synthid-firefox-extension",
  "version": "1.0.1",
  "private": true,
  "description": "Firefox extension: right-click media to check it for a SynthID watermark on synthid.com",
  "license": "MIT",
  "scripts": {
    "lint": "web-ext lint",
    "test:live": "node scripts/test-synthid-live.js",
    "test": "node --test \"test/*.test.js\"",
    "test:chrome": "npm run build:chrome && node --test \"test/chrome/*.test.js\"",
    "build": "web-ext build --overwrite-dest",
    "build:chrome": "node scripts/build-chrome.js && web-ext build --no-config-discovery --source-dir dist/chrome --filename \"{name}-chrome-{version}.zip\" --overwrite-dest",
    "start": "web-ext run"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.0",
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
